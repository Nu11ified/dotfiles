#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/run/current-system/sw/bin:/etc/profiles/per-user/$USER/bin:$PATH"

dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
sketchybar_config="$HOME/.config/sketchybar/sketchybarrc"
aerospace_query="$HOME/.config/aerospace/scripts/aerospace-query"
if [ -f "$dotfiles_dir/config/sketchybar/sketchybarrc" ]; then
  sketchybar_config="$dotfiles_dir/config/sketchybar/sketchybarrc"
fi
if [ -x "$dotfiles_dir/config/aerospace/scripts/aerospace-query" ]; then
  aerospace_query="$dotfiles_dir/config/aerospace/scripts/aerospace-query"
fi

defaults write NSGlobalDomain _HIHideMenuBar -bool true || true
defaults write NSGlobalDomain AppleMenuBarVisibleInFullscreen -bool false || true
defaults write NSGlobalDomain AppleInterfaceStyle -string Dark || true
defaults write com.apple.universalaccess reduceTransparency -bool true 2>/dev/null || true
killall SystemUIServer 2>/dev/null || true
killall ControlCenter 2>/dev/null || true

if command -v aerospace >/dev/null 2>&1; then
  pkill -f '/.config/sketchybar/plugins/aerospace_workspaces.sh' 2>/dev/null || true
  open -gj -a AeroSpace || true
  for _ in $(seq 1 30); do
    if "$aerospace_query" list-monitors >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
  aerospace reload-config
fi

pkill -x spacebar 2>/dev/null || true

if command -v sketchybar >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew services start sketchybar >/tmp/sketchybar-service.log 2>&1 || true
  fi
  if ! sketchybar --reload "$sketchybar_config" >/tmp/sketchybar.log 2>&1; then
    nohup sketchybar --config "$sketchybar_config" >/tmp/sketchybar.log 2>&1 &
  fi
  sleep 0.5
  "$HOME/.config/sketchybar/plugins/aerospace_toggle.sh" restore || true
fi

if command -v borders >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew services start borders >/tmp/borders-service.log 2>&1 || true
    sleep 0.5
  fi
  if pgrep -x borders >/dev/null 2>&1; then
    "$HOME/.config/borders/bordersrc" >/tmp/borders.log 2>&1 || true
  elif [ -x "$HOME/.config/borders/bordersrc" ]; then
    nohup "$HOME/.config/borders/bordersrc" >/tmp/borders.log 2>&1 </dev/null &
  else
    nohup borders active_color=0xfff5c2e7 inactive_color=0x00ffffff width=3.5 hidpi=on style=round >/tmp/borders.log 2>&1 </dev/null &
  fi
fi

echo "Started AeroSpace, SketchyBar, and JankyBorders"
