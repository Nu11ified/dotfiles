#!/usr/bin/env bash
set -euo pipefail

if ! command -v displayplacer >/dev/null 2>&1; then
  exit 0
fi

macbook_id="37D8832A-2D66-02CA-B9F7-8F30A301B230"
horizontal_id="1733313D-7A5B-4B1A-A510-DD2A879CBE26"
vertical_id="DF66F73B-21AC-4535-90F1-84C48D94ED5A"
screen_state="$(displayplacer list 2>/dev/null || true)"

if [ "$(printf '%s\n' "$screen_state" | grep -c '^Persistent screen id:')" -ne 3 ]; then
  exit 0
fi

for screen_id in "$macbook_id" "$horizontal_id" "$vertical_id"; do
  if ! printf '%s\n' "$screen_state" | grep -Fq "Persistent screen id: $screen_id"; then
    exit 0
  fi
done

vertical_origin="$(
  printf '%s\n' "$screen_state" \
    | awk -v id="$vertical_id" '
        $0 == "Persistent screen id: " id { in_screen = 1; next }
        in_screen && /^Origin:/ { print; exit }
      '
)"
if [ "$vertical_origin" = "Origin: (1512,-1038)" ]; then
  exit 0
fi

# The gap below the vertical display gives AeroSpace a free bottom corner in
# which to park hidden MacBook workspaces without leaking them onto a monitor.
reenable_aerospace=0
if command -v aerospace >/dev/null 2>&1 \
  && aerospace enable off --fail-if-noop >/dev/null 2>&1; then
  reenable_aerospace=1
fi

restore_aerospace() {
  if [ "$reenable_aerospace" -eq 1 ]; then
    aerospace enable on >/dev/null 2>&1 || true
  fi
}
trap restore_aerospace EXIT

displayplacer \
  "id:$macbook_id res:1512x982 hz:120 color_depth:8 enabled:true scaling:on origin:(0,0) degree:0" \
  "id:$horizontal_id res:2560x1440 hz:60 color_depth:8 enabled:true scaling:off origin:(-2560,-424) degree:0" \
  "id:$vertical_id res:1080x1920 hz:60 color_depth:8 enabled:true scaling:on origin:(1512,-1038) degree:90"

restore_aerospace
reenable_aerospace=0

if command -v sketchybar >/dev/null 2>&1; then
  sketchybar --trigger aerospace_workspace_change FULL_REFRESH=1
fi
