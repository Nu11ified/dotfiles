#!/usr/bin/env bash
set -euo pipefail

if ! command -v aerospace >/dev/null 2>&1; then
  exit 0
fi

lock_dir="${TMPDIR:-/tmp}/aerospace-arrange-monitors.lock"
lock_acquired=0

# Login, wake, and display-change callbacks can arrive together. Serialize them
# so a later pass observes the final macOS display arrangement.
for attempt in $(seq 1 100); do
  if mkdir "$lock_dir" 2>/dev/null; then
    printf '%s\n' "$$" > "$lock_dir/pid"
    lock_acquired=1
    break
  fi

  lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  if [ -n "$lock_pid" ] && ! ps -p "$lock_pid" -o command= 2>/dev/null | grep -q '[a]rrange-monitors'; then
    rm -f "$lock_dir/pid"
    rmdir "$lock_dir" 2>/dev/null || true
    continue
  fi
  if [ -z "$lock_pid" ] && [ "$attempt" -ge 20 ]; then
    rmdir "$lock_dir" 2>/dev/null || true
    continue
  fi
  sleep 0.05
done

if [ "$lock_acquired" -ne 1 ]; then
  exit 0
fi
trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir" 2>/dev/null || true' EXIT

monitors=""
previous_monitors=""
stable_samples=0
for _ in $(seq 1 50); do
  current_monitors="$(
    aerospace list-monitors \
      --format '%{monitor-id}|%{monitor-is-main}|%{monitor-appkit-nsscreen-screens-id}' \
      2>/dev/null || true
  )"

  if [ -n "$current_monitors" ] && [ "$current_monitors" = "$previous_monitors" ]; then
    stable_samples=$((stable_samples + 1))
  else
    stable_samples=0
    previous_monitors="$current_monitors"
  fi

  if [ "$stable_samples" -ge 2 ]; then
    monitors="$current_monitors"
    break
  fi
  sleep 0.1
done

if [ -z "$monitors" ]; then
  monitors="$previous_monitors"
fi

main_monitor="$(printf '%s\n' "$monitors" | awk -F '|' '$2 == "true" { print $1; exit }')"

if [ -z "$main_monitor" ]; then
  exit 0
fi

expected_assignments=""

assign_workspace() {
  local workspace="$1"
  local monitor_id="$2"

  aerospace move-workspace-to-monitor --workspace "$workspace" "$monitor_id" >/dev/null 2>&1 || true
  expected_assignments+="$workspace|$monitor_id"$'\n'
}

# AeroSpace already moves workspaces off disconnected displays. Resetting all
# nine here makes every window jump during transient dock/display changes.
for workspace in 1 2 3 4 5; do
  assign_workspace "$workspace" "$main_monitor"
done

external_index=0
while IFS='|' read -r monitor_id is_main _nsscreen_id; do
  if [ -z "$monitor_id" ] || [ "$is_main" = "true" ]; then
    continue
  fi

  case "$external_index" in
    0) workspaces="6 7" ;;
    1) workspaces="8 9" ;;
    *) break ;;
  esac

  for workspace in $workspaces; do
    assign_workspace "$workspace" "$monitor_id"
  done
  external_index=$((external_index + 1))
done <<< "$monitors"

# Do not publish a bar layout until AeroSpace reports the requested mapping.
for _ in $(seq 1 40); do
  workspace_monitors="$(
    aerospace list-workspaces --all --format '%{workspace}|%{monitor-id}' 2>/dev/null || true
  )"
  assignments_ready=1

  while IFS='|' read -r workspace monitor_id; do
    if [ -z "$workspace" ]; then
      continue
    fi
    if ! printf '%s\n' "$workspace_monitors" | awk -F '|' \
      -v workspace="$workspace" -v monitor_id="$monitor_id" \
      '$1 == workspace && $2 == monitor_id { found=1 } END { exit !found }'; then
      assignments_ready=0
      break
    fi
  done <<< "$expected_assignments"

  if [ "$assignments_ready" -eq 1 ]; then
    break
  fi
  sleep 0.05
done

if command -v sketchybar >/dev/null 2>&1; then
  sketchybar --trigger aerospace_workspace_change FULL_REFRESH=1 >/dev/null 2>&1 || true
fi
