#!/usr/bin/env bash
set -euo pipefail

app_name="${1:?app name is required}"
mode="${2:-activate}"

case "$mode" in
  new-window)
    was_running="$(osascript -e "application \"$app_name\" is running" 2>/dev/null || printf false)"
    open -a "$app_name"
    if [ "$was_running" = "true" ]; then
      sleep 0.3
      osascript \
        -e "tell application \"$app_name\" to activate" \
        -e 'delay 0.1' \
        -e 'tell application "System Events" to keystroke "n" using command down'
    fi
    ;;

  new-tab)
    open -a "$app_name"
    sleep 0.3
    osascript \
      -e "tell application \"$app_name\" to activate" \
      -e 'delay 0.1' \
      -e 'tell application "System Events" to keystroke "t" using command down'
    ;;

  *)
    open -a "$app_name"
    ;;
esac
