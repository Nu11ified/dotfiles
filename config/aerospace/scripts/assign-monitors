#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/run/current-system/sw/bin:$PATH"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aerospace"
mkdir -p "$state_dir"
# Workspace moves emit bar events; only one topology update may run at a time.
exec /usr/bin/perl -MFcntl=:flock -e '
  open(my $lock, ">", shift @ARGV) or die $!;
  flock($lock, LOCK_EX | LOCK_NB) or exit 0;
  system(@ARGV);
  exit($? >> 8);
' "$state_dir/monitor-routing.lock" /bin/bash -s <<'ROUTE'
set -euo pipefail
query="$HOME/.config/aerospace/scripts/aerospace-query"
routing_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aerospace/orientation"
mkdir -p "$routing_dir"
if [ -r "${XDG_STATE_HOME:-$HOME/.local/state}/aerospace/enabled" ] &&
   [ "$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/aerospace/enabled")" = off ]; then
  exit 0
fi
# A crash leaves the bar alive. Relaunch at most once a minute, and respect
# the user's off switch. A live but unresponsive process is never killed here.
if ! "$query" list-monitors >/dev/null 2>&1; then
  if ! pgrep -x AeroSpace >/dev/null 2>&1; then
    recovery_dir="${XDG_STATE_HOME:-$HOME/.local/state}/aerospace"
    now="$(date +%s)"
    last_start=0
    if [ -r "$recovery_dir/last-restart" ]; then
      read -r last_start < "$recovery_dir/last-restart" || true
    fi
    case "$last_start" in ''|*[!0-9]*) last_start=0 ;; esac
    if [ "$((now - last_start))" -ge 60 ]; then
      printf '%s\n' "$now" > "$recovery_dir/last-restart"
      /usr/bin/open -gj -a AeroSpace
    fi
  fi
  ready=0
  for attempt in 1 2 3 4 5; do
    if "$query" list-monitors >/dev/null 2>&1; then ready=1; break; fi
    sleep 0.2
  done
  [ "$ready" -eq 1 ] || exit 1
fi
plan=""
previous_topology=""
for attempt in 1 2 3 4 5; do
  monitors="$("$query" list-monitors --format '%{monitor-id}|%{monitor-appkit-nsscreen-screens-id}' 2>/dev/null || true)"
  displays="$(sketchybar --query displays 2>/dev/null || true)"
  if [ -z "$monitors" ] || ! printf '%s\n' "$displays" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
    sleep 0.2
    continue
  fi
  topology="$(printf '%s\n' "$displays" | jq -c 'sort_by(.DirectDisplayID) | map({DirectDisplayID, frame})')|$monitors"
  if [ "$topology" != "$previous_topology" ]; then
    previous_topology="$topology"
    sleep 0.2
    continue
  fi
  plan="$(jq -nr --arg monitors "$monitors" --argjson displays "$displays" '
    ($monitors | split("\n") | map(select(length > 0) | split("|") |
      {id: (.[0]|tonumber), direct: (.[1]|tonumber)})) as $monitors |
    [$displays[] as $d | $monitors[] | select(.direct == $d.DirectDisplayID) |
      . + {x: $d.frame.x, y: $d.frame.y,
        layout: (if $d.frame.h > $d.frame.w then "v_tiles" else "h_tiles" end),
        signature: "\($d.DirectDisplayID):\($d.frame.w):\($d.frame.h)"}] | sort_by(.x, .y) |
    if length == 0 or length != ($monitors|length) or length != ($displays|length) then empty else
      . as $screens | length as $n |
      [range(0; $n) as $i |
        (((9 / $n)|floor) + (if $i < (9 % $n) then 1 else 0 end)) as $size |
        range(0; $size) | $screens[$i]] |
      to_entries[] | "\(.key + 1)|\(.value.id)|\(.value.layout)|\(.value.signature)"
    end')"
  [ -n "$plan" ] && break
  sleep 0.2
done
[ -n "$plan" ] || exit 1
current="$("$query" list-workspaces --all --format '%{workspace}|%{monitor-id}')"
focused_workspace="$("$query" list-workspaces --focused)"
moved=0
while IFS='|' read -r workspace monitor orientation signature; do
  if ! printf '%s\n' "$current" | grep -Fxq "$workspace|$monitor"; then
    "$query" move-workspace-to-monitor --workspace "$workspace" "$monitor"
    moved=1
  fi
done <<< "$plan"
# AeroSpace creates numbered overflow workspaces while displays reconnect.
# Keep their windows reachable through the configured 1..9 shortcuts.
while IFS='|' read -r workspace monitor; do
  case "$workspace" in ''|*[!0-9]*) continue ;; esac
  [ "${#workspace}" -lt 6 ] || continue
  [ "$workspace" -gt 9 ] || continue
  target="$(printf '%s\n' "$plan" | awk -F '|' -v monitor="$monitor" '$2 == monitor {print $1; exit}')"
  [ -n "$target" ] || continue
  windows="$("$query" list-windows --workspace "$workspace" --format '%{window-id}')"
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    "$query" move-node-to-workspace --window-id "$window" "$target"
    moved=1
  done <<< "$windows"
  if [ "$focused_workspace" = "$workspace" ]; then
    focused_workspace="$target"
  fi
done <<< "$current"
# Preserve manual tiled orientations, but repair overlapping accordion layouts
# even when the screen has not changed.
root_layouts="$("$query" list-workspaces --all --format '%{workspace}|%{workspace-root-container-layout}')"
while IFS='|' read -r workspace monitor orientation signature; do
  previous_signature=""
  if [ -r "$routing_dir/$workspace" ]; then
    read -r previous_signature < "$routing_dir/$workspace" || true
  fi
  root_layout="$(printf '%s\n' "$root_layouts" | awk -F '|' -v workspace="$workspace" '$1 == workspace {print $2; exit}')"
  if [ "$previous_signature" != "$signature" ] || [[ "$root_layout" = *_accordion ]]; then
    "$query" layout --workspace "$workspace" --root "$orientation"
    "$query" balance-sizes --workspace "$workspace"
    printf '%s\n' "$signature" > "$routing_dir/$workspace.tmp"
    mv "$routing_dir/$workspace.tmp" "$routing_dir/$workspace"
  fi
done <<< "$plan"
if [ "$moved" -eq 1 ]; then
  "$query" workspace "$focused_workspace"
fi
exit 0
ROUTE
