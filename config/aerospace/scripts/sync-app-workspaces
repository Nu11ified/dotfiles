#!/usr/bin/env bash
set -euo pipefail

if ! command -v aerospace >/dev/null 2>&1; then
  exit 0
fi

aerospace list-windows --all --format '%{window-id}|%{app-bundle-id}' |
  while IFS='|' read -r window_id bundle_id; do
    target=""

    case "$bundle_id" in
      app.zen-browser.zen) target="1" ;;
      com.mitchellh.ghostty|com.apple.Terminal|com.termius-dmg.mac|org.gnu.Emacs) target="2" ;;
      com.openai.codex|com.anthropic.claude-code-url-handler) target="3" ;;
      com.todesktop.230313mzl4w4u92|com.microsoft.VSCode) target="4" ;;
      com.apple.MobileSMS|com.hnc.Discord) target="5" ;;
    esac

    if [ -n "$target" ]; then
      aerospace move-node-to-workspace --window-id "$window_id" "$target" >/dev/null 2>&1 || true
    fi
  done
